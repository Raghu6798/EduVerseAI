# --- Stage 1: Base image ---
FROM oven/bun:1.1.20-alpine AS base
WORKDIR /app

# --- Stage 2: Dependencies ---
FROM base AS deps
# Copy dependency manifests
COPY package.json bun.lockb* ./
# Install dependencies using bun's high-performance package manager
# Note: --frozen-lockfile is recommended for reproducible CI builds
RUN bun install 

# --- Stage 3: Builder ---
FROM deps AS builder
# Accept build-time environment variables for Vite/React bundle
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL

# Convert build arguments to environment variables so Vite can use them
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Copy source code
COPY . .
# Run the vite build process (results in /app/dist)
RUN bun run build

# --- Stage 4: Release (Production) ---
FROM nginx:stable-alpine AS runner

# Set metadata labels
LABEL maintainer="Eduverse AI" \
      version="1.0.0" \
      description="Eduverse AI Frontend served with Nginx"

# Copy custom nginx configuration to handle SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy build artifacts from builder stage (the 'dist' folder generated by Vite)
COPY --from=builder /app/dist /usr/share/nginx/html

# Run on port 80
EXPOSE 80

# Health check to ensure the application is reachable
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
